# JWT Secret Key (Generate a random 32+ character hex string in production)
JWT_SECRET_KEY=your_super_secret_key_here_min_32_chars

# Database URL (Defaults to SQLite for local development; in production use PostgreSQL)
# Example PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/taskdb
DATABASE_URL=sqlite:///./tasks.db

# Optional: Port configuration for deployment
PORT=8000
